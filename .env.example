# Copy to .env (never commit .env). Long random value: e.g. `openssl rand -hex 24`.
CLIPSYNC_API_KEY=change-me
CLIPSYNC_PORT=5000
# DSM user/group that owns the ./data folder (check with `id` over SSH).
CLIPSYNC_UID=1024
CLIPSYNC_GID=100

# AI chat / research: DeepSeek, Ollama or OpenAI (all OpenAI-compatible).
# Leave AI_PROVIDER empty to use the first one configured (deepseek, then ollama, then openai).
AI_PROVIDER=deepseek
# Optional model override. Defaults: deepseek-chat / gemma4:e4b / gpt-4o-mini.
AI_MODEL=
DEEPSEEK_API_KEY=
# Ollama on your PC or the NAS, e.g. 192.168.1.50:11434 (start Ollama with OLLAMA_HOST=0.0.0.0
# on that machine so other devices can reach it).
OLLAMA_HOST=
OPENAI_API_KEY=

# Cloudflare Tunnel (Zero Trust -> Networks -> Tunnels -> your tunnel -> token).
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# One-time import of the old clipsync-db history (API token with "D1 Read").
CF_ACCOUNT_ID=
CF_API_TOKEN=
D1_DATABASE_ID=
