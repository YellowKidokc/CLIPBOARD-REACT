# Copy to .env (never commit .env). Long random value: e.g. `openssl rand -hex 24`.
CLIPSYNC_API_KEY=change-me
CLIPSYNC_PORT=5000
# DSM user/group that owns the ./data folder (check with `id` over SSH).
CLIPSYNC_UID=1024
CLIPSYNC_GID=100

# Optional: AI chat / research.
OPENAI_API_KEY=

# Cloudflare Tunnel (Zero Trust -> Networks -> Tunnels -> your tunnel -> token).
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# One-time import of the old clipsync-db history (API token with "D1 Read").
CF_ACCOUNT_ID=
CF_API_TOKEN=
D1_DATABASE_ID=
